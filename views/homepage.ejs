<%- include( './partials/head', {title: title} ) %>
<body>
  <%- include("./partials/navBar" ) %>
  <h1>Home Page</h1>
  <% for(let i = 0; i < messages.length; i++) { %>
    <div class="message">
      <h4><%= messages[i].name %></h4>
      <p><%= messages[i].text %></p>
      <i><%= messages[i].time %></i>
    </div>
  <% } %>
</body>
